<view class="my-page">
  <view class="user-area">
    <view wx:if="{{!hasUserInfo}}" class="guest-panel">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
      >
        <image
          wx:if="{{userInfo.avatarUrl}}"
          class="guest-avatar"
          src="{{userInfo.avatarUrl}}"
          mode="aspectFill"
        ></image>
        <view wx:else class="avatar-placeholder">
          <text class="avatar-plus">+</text>
          <text class="avatar-label">ADD PHOTO</text>
        </view>
      </button>
      <text class="avatar-hint">选择头像</text>
      <text class="guest-title">欢迎来到 OUC NEWS</text>
      <text class="guest-description">登录后可以管理你的新闻收藏</text>
      <input
        class="nickname-input"
        type="nickname"
        placeholder="请输入昵称"
        bindinput="onInputChange"
      />
      <view class="login-btn" bindtap="login">登录</view>
    </view>

    <view wx:else class="profile-card">
      <image
        class="user-avatar"
        src="{{userInfo.avatarUrl}}"
        mode="aspectFill"
      ></image>
      <text class="user-name">{{userInfo.nickName}}</text>
      <text class="reader-label">OUC NEWS READER</text>
      <view class="profile-divider"></view>
      <text class="collect-number">{{collectList.length}}</text>
      <text class="collect-label">我的收藏</text>
    </view>
  </view>

  <view wx:if="{{hasUserInfo}}" class="collect-area">
    <view class="collection-header">
      <view>
        <text class="collection-en">MY COLLECTION</text>
        <text class="my-title">我的收藏</text>
      </view>
      <text class="collection-count">{{collectList.length}} ITEMS</text>
    </view>

    <view wx:if="{{collectList.length === 0}}" class="empty-state">
      <text class="empty-title">暂无收藏</text>
      <text class="empty-text">看到感兴趣的新闻时，点击“收藏本文”即可在这里找到。</text>
    </view>

    <view
      class="collect-item"
      wx:for="{{collectList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <image
        class="collect-image"
        src="{{item.poster}}"
        mode="aspectFill"
      ></image>
      <view class="collect-info">
        <view class="collect-meta">
          <text wx:if="{{item.category}}" class="collect-category">{{item.category}} · </text>
          <text class="collect-date">{{item.add_date}}</text>
        </view>
        <text class="collect-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{hasUserInfo}}" class="history-area">
    <view class="collection-header">
      <view>
        <text class="collection-en">RECENTLY VIEWED</text>
        <text class="my-title">最近浏览</text>
      </view>
      <text class="collection-count">{{historyList.length}} ITEMS</text>
    </view>

    <view wx:if="{{historyList.length === 0}}" class="history-empty">
      <text class="empty-title">暂无浏览记录</text>
      <text class="empty-text">阅读新闻后，最近浏览会出现在这里。</text>
    </view>

    <view
      class="collect-item"
      wx:for="{{historyList}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="goDetail"
    >
      <image
        class="collect-image"
        src="{{item.poster}}"
        mode="aspectFill"
      ></image>
      <view class="collect-info">
        <view class="collect-meta">
          <text wx:if="{{item.category}}" class="collect-category">{{item.category}} · </text>
          <text class="collect-date">{{item.add_date}}</text>
        </view>
        <text class="collect-title">{{item.title}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{hasUserInfo}}" class="logout-area">
    <view class="logout-btn" bindtap="logout">退出登录</view>
  </view>
</view>
