<view class="waterfall"><view wx:for="{{columns}}" wx:for-item="column" wx:key="id" class="column"><view wx:for="{{column.posts}}" wx:for-item="post" wx:key="_id" class="image-card" data-id="{{post._id}}" bindtap="openPost"><view class="image-wrap"><image class="image" src="{{post.images[0]}}" mode="widthFix" lazy-load /><text wx:if="{{post.images.length > 1}}" class="photo-count">{{post.images.length}} 张</text></view><view wx:if="{{post.caption}}" class="caption">{{post.caption}}</view><view class="card-footer"><view class="user-info" catchtap="openUser" data-openid="{{post._openid}}"><image class="avatar" src="{{post.author.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"/><text>{{post.author.nickName}}</text></view><text class="likes">♡ {{post.likeCount}}</text></view></view></view></view>
