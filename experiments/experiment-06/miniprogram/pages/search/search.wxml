<view class="screen"><view class="title">搜索</view><view class="search-bar"><view class="search-input-wrap"><view class="search-symbol"></view><input class="search-input" placeholder="搜索动态、同学或标签" value="{{keyword}}" maxlength="60" bindinput="onSearchInput" bindconfirm="onSearchConfirm" confirm-type="search" /></view><button class="search-btn" bindtap="onSearchConfirm">搜索</button></view>
<view class="tabs"><text class="{{activeTab === 'post' ? 'active' : ''}}" data-tab="post" bindtap="onTabChange">动态</text><text class="{{activeTab === 'user' ? 'active' : ''}}" data-tab="user" bindtap="onTabChange">同学</text><text class="{{activeTab === 'tag' ? 'active' : ''}}" data-tab="tag" bindtap="onTabChange">标签</text></view>
<view wx:if="{{searchedKeyword}}" class="search-summary">{{exactTag && activeTab === 'post' ? '标签' : '搜索结果'}}：{{searchedKeyword}}</view>
<post-grid wx:if="{{activeTab === 'post'}}" posts="{{posts}}"/>
<block wx:if="{{activeTab === 'user'}}">
<view class="user-list"><view class="user-item" wx:for="{{users}}" wx:key="_openid"><view class="user-info" bindtap="onUserTap" data-openid="{{item._openid}}"><image class="avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"/><view class="user-detail"><view class="nickname">{{item.nickName}}</view><view class="follower-count">{{item.followerCount || 0}} 位关注者</view></view></view><button wx:if="{{!item.isSelf}}" class="follow-btn {{item.isFollowed ? 'followed' : ''}}" data-openid="{{item._openid}}" bindtap="onFollowTap" disabled="{{followBusy[item._openid]}}">{{item.isFollowed ? '已关注' : '关注'}}</button></view></view>
<view wx:if="{{followError}}" class="error">{{followError}} 请再次点击关注重试。</view></block>
<view wx:if="{{activeTab === 'tag'}}"><view wx:for="{{tags}}" wx:key="name" class="tag-result" data-tag="{{item.name}}" bindtap="onTagTap"><view class="tag-name">#{{item.name}}</view><text>{{item.count}} 条动态</text><text class="tag-arrow">↗</text></view></view>
<view wx:if="{{error}}" class="state error">{{error}}<button class="secondary" bindtap="retry">重新搜索</button></view><view wx:elif="{{!searchedKeyword}}" class="state">搜一搜校园里的照片和同学</view><view wx:elif="{{hasSearched && !loading && ((activeTab === 'post' && !posts.length) || (activeTab === 'user' && !users.length) || (activeTab === 'tag' && !tags.length))}}" class="state">没有找到相关结果，换个关键词试试</view><view wx:if="{{loading}}" class="state">正在搜索…</view><view wx:elif="{{hasSearched && !hasMore && (posts.length || users.length || tags.length)}}" class="state small">已经显示全部结果</view>
</view>
