.cover { height: 260rpx; background: #EDF4FF; position: relative; overflow: hidden; }
.cover image { width: 100%; height: 100%; }
.cover-art { height: 100%; background: linear-gradient(125deg,#EDF4FF,#D6E7FF); }
.cover-line { width: 640rpx; height: 280rpx; border: 26rpx solid rgba(9,101,243,.10); border-radius: 50%; transform: rotate(-22deg); position: absolute; right: -150rpx; bottom: -205rpx; }
.profile-info { position: relative; margin-top: -85rpx; }
.profile-avatar { width: 136rpx; height: 136rpx; border: 8rpx solid white; border-radius: 50%; background: #F3F5F8; }
.profile-actions { position: absolute; right: 0; top: 94rpx; }
.profile-actions button { min-width: 168rpx; width: auto; height: 68rpx; line-height: 68rpx; padding: 0 26rpx; font-size: 25rpx; margin: 0; }
.profile-info .title { max-width: 65%; overflow-wrap: anywhere; font-size: 46rpx; font-weight: 900; letter-spacing: -1rpx; margin-top: 18rpx; }
.profile-info .subtitle { max-width: 100%; word-break: break-all; font-size: 25rpx; color: #89919D; }
.stats { display: flex; padding: 26rpx 0; margin: 18rpx 0; border-bottom: 1rpx solid #EEF0F4; font-size: 22rpx; color: #89919D; }
.stats > view { flex: 1; }
.stats text { display: block; color: #101114; font-size: 44rpx; font-weight: 800; line-height: 1.3; margin-bottom: 8rpx; }
.account-actions { display: flex; gap: 16rpx; }
.account-actions button { flex: 1; height: 80rpx; line-height: 80rpx; margin: 0; padding: 0 16rpx; font-size: 25rpx; }
.account-actions text { color: #0965F3; }
.archive-grid { display: flex; flex-wrap: wrap; gap: 8rpx; }
.tile { width: calc((100% - 16rpx) / 3); height: 218rpx; position: relative; }
.tile image { width: 100%; height: 100%; border-radius: 10rpx; background: #EFF3F8; }
.photo-count { position: absolute; right: 8rpx; bottom: 9rpx; font-size: 19rpx; color: white; background: rgba(10,20,35,.45); border-radius: 6rpx; padding: 2rpx 7rpx; }
.editor-overlay { position: fixed; top: 0; bottom: 0; left: 0; right: 0; z-index: 1000; background: rgba(16,20,28,.38); display: flex; align-items: flex-end; }
.editor-form { width: 100%; }
.editor-panel { width: 100%; height: 86vh; background: #fff; border-radius: 30rpx 30rpx 0 0; overflow: hidden; display: flex; flex-direction: column; }
.editor-header { height: 138rpx; padding: 28rpx 32rpx 22rpx; display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; border-bottom: 1rpx solid #F1F3F6; }
.editor-title { font-size: 37rpx; font-weight: 800; color: #101114; }
.editor-subtitle { font-size: 22rpx; color: #929AA7; margin-top: 3rpx; }
.close-editor { width: 64rpx; height: 64rpx; min-width: 64rpx; margin: 0; padding: 0; line-height: 60rpx; border-radius: 50%; background: #F3F5F8; color: #818B9A; font-size: 38rpx; font-weight: 400; }
.editor-content { flex: none; height: calc(86vh - 270rpx - env(safe-area-inset-bottom)); }
.editor-padding { padding: 26rpx 32rpx 20rpx; }
.edit-cover { height: 176rpx; position: relative; border-radius: 16rpx; overflow: hidden; background: #E7F0FE; }
.edit-cover image, .cover-placeholder { width: 100%; height: 100%; }
.cover-placeholder { background: linear-gradient(125deg,#EAF3FF,#BCD6FD); }
.change-cover { position: absolute; right: 14rpx; bottom: 14rpx; width: auto; height: 56rpx; line-height: 56rpx; padding: 0 20rpx; border-radius: 10rpx; background: rgba(255,255,255,.95); color: #243348; font-size: 22rpx; margin: 0; }
.edit-avatar-row { display: flex; align-items: center; gap: 18rpx; margin: 26rpx 0; }
.edit-avatar { width: 84rpx; height: 84rpx; border-radius: 50%; background: #F0F3F7; }
.avatar-label { flex: 1; font-size: 26rpx; font-weight: 700; }
.avatar-label text { display: block; font-size: 21rpx; color: #949CAA; font-weight: 400; margin-top: 3rpx; }
.change-avatar { height: 60rpx; line-height: 60rpx; width: auto; min-width: 100rpx; padding: 0 22rpx; margin: 0; font-size: 23rpx; color: #0965F3; background: #EDF4FF; }
.form-label { display: flex; justify-content: space-between; font-size: 27rpx; font-weight: 700; margin: 22rpx 0 12rpx; }
.form-label text { font-size: 21rpx; font-weight: 400; color: #9BA3AF; }
.edit-field { width: 100%; height: 82rpx; border-radius: 12rpx; background: #F5F7FA; padding: 20rpx; font-size: 27rpx; color: #101114; }
.edit-bio { height: 158rpx; line-height: 1.7; }
.editor-footer { height: calc(132rpx + env(safe-area-inset-bottom)); flex-shrink: 0; padding: 20rpx 32rpx calc(22rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #F0F2F5; background: white; }
.editor-footer button { width: 100%; height: 88rpx; line-height: 88rpx; margin: 0; padding: 0; }
.edit-status { font-size: 23rpx; line-height: 1.6; padding-top: 18rpx; }
