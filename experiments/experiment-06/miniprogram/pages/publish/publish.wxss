.caption-input { width: 100%; height: 190rpx; margin: 28rpx 0; padding: 24rpx; background: #F4F7FB; border-radius: 18rpx; line-height: 1.8; font-size: 30rpx; }
.selected-photos { display: flex; flex-wrap: wrap; margin: 16rpx -5rpx; }
.photo-wrap, .add-photo { position: relative; flex: 0 0 calc(33.333% - 10rpx); width: calc(33.333% - 10rpx); min-width: 0; padding: 0; height: 218rpx; margin: 5rpx; border-radius: 10rpx; overflow: hidden; }
.photo-wrap image { width: 100%; height: 100%; }
.remove { position: absolute; top: 7rpx; right: 7rpx; padding: 0; width: 42rpx; height: 42rpx; line-height: 38rpx; border-radius: 50%; color: #fff; background: rgba(17,24,39,.75); }
.add-photo { display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F0F7FF; border: 1rpx dashed #9DC6FF; color: #0965F3; font-size: 21rpx; line-height: 1.5; }
.plus { font-size: 58rpx; font-weight: 500; margin-bottom: 8rpx; }
.field { width: 100%; height: 86rpx; padding: 18rpx 22rpx; background: #F4F7FB; border-radius: 10rpx; font-size: 26rpx; }
.tag-input { flex: 1; min-width: 0; }
.tag-add { margin-left: 12rpx; }
.post-button { margin-top: 50rpx; background: #0965F3; color: #FFFFFF; }
.progress { margin-top: 32rpx; line-height: 2; }
.publish-error { font-size: 24rpx; line-height: 1.8; margin-top: 24rpx; }

.post-button[disabled] { background: #E5EAF1; color: #929DAE; opacity: 1; }
