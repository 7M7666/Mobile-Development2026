<view class="screen"><view class="title">发现</view><view class="search-entry" bindtap="openSearch"><view class="search-symbol"></view><text>搜索动态、同学或标签</text></view>
<view class="section-title">近期热门标签</view><view class="tag-cloud"><text class="tag-chip {{!selectedTag ? 'selected' : ''}}" data-tag="" bindtap="onTagTap">全部</text><text wx:for="{{hotTags}}" wx:key="name" class="tag-chip {{selectedTag === item.name ? 'selected' : ''}}" data-tag="{{item.name}}" bindtap="onTagTap">#{{item.name}}</text></view><view wx:if="{{tagError}}" class="error" bindtap="loadHotTags">{{tagError}} 点击重试</view>
<view class="people-section"><view class="section-title">遇见同学</view>
<view class="user-list"><view class="user-item" wx:for="{{recommendedUsers}}" wx:key="_openid"><view class="user-info" bindtap="onUserTap" data-openid="{{item._openid}}"><image class="avatar" src="{{item.avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"/><view class="user-detail"><view class="nickname">{{item.nickName}}</view><view class="follower-count">{{item.followerCount || 0}} 位关注者</view></view></view><button wx:if="{{!item.isSelf}}" class="follow-btn {{item.isFollowed ? 'followed' : ''}}" data-openid="{{item._openid}}" bindtap="onFollowTap" disabled="{{followBusy[item._openid]}}">{{item.isFollowed ? '已关注' : '关注'}}</button></view></view>
<view wx:if="{{peopleLoading}}" class="small">正在寻找同学…</view><view wx:if="{{peopleError}}" class="error" bindtap="loadRecommendedUsers">{{peopleError}} 点击重试</view><view wx:elif="{{!peopleLoading && !recommendedUsers.length}}" class="small">暂时没有新的推荐同学</view></view>
<view class="tabs"><text class="{{sortBy === 'newest' ? 'active' : ''}}" data-sort="newest" bindtap="onSortChange">最新照片</text><text class="{{sortBy === 'hot' ? 'active' : ''}}" data-sort="hot" bindtap="onSortChange">热门照片</text></view>
<view wx:if="{{selectedTag}}" class="filter-caption">正在看 #{{selectedTag}} <text data-tag="" bindtap="onTagTap">清除筛选</text></view>
<post-grid posts="{{posts}}"/><view wx:if="{{error}}" class="state error">{{error}}<button class="secondary" bindtap="retry">重新加载</button></view><view wx:elif="{{!loading && !posts.length}}" class="state">{{selectedTag ? '这个标签还没有照片' : '还没有校园照片，去发布第一条吧'}}</view><view wx:if="{{loading}}" class="state">正在加载…</view><view wx:elif="{{posts.length && !hasMore}}" class="state small">已经看完啦</view></view>
