.search-entry, .search-input-wrap { display: flex; align-items: center; gap: 18rpx; border-radius: 16rpx; background: #F3F5F8; height: 88rpx; padding: 0 24rpx; color: #8A919D; font-size: 27rpx; }
.search-symbol { width: 25rpx; height: 25rpx; border: 3rpx solid #8A919D; border-radius: 50%; position: relative; flex-shrink: 0; }
.search-symbol:after { content: ''; position: absolute; width: 11rpx; height: 3rpx; background: #8A919D; transform: rotate(45deg); right: -8rpx; bottom: -4rpx; }
.user-item { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx 0; }
.user-info { display: flex; align-items: center; gap: 18rpx; flex: 1; min-width: 0; }
.user-detail { min-width: 0; }
.nickname { color: #101114; font-size: 28rpx; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.follower-count { color: #8A919D; font-size: 22rpx; margin-top: 4rpx; }
.follow-btn { margin: 0; padding: 0 24rpx; height: 64rpx; line-height: 64rpx; min-width: 116rpx; width: auto; background: #0965F3; color: white; font-size: 24rpx; border-radius: 12rpx; flex-shrink: 0; }
.followed { background: #F1F4F8; color: #7B8492; }

.tag-cloud { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag-chip { border-radius: 10rpx; background: #F4F6F9; color: #596372; padding: 10rpx 20rpx; font-size: 24rpx; }
.tag-chip.selected { background: #E9F2FF; color: #0965F3; font-weight: 700; }
.people-section { margin: 24rpx 0 36rpx; padding-bottom: 24rpx; border-bottom: 1rpx solid #F0F2F5; }
.filter-caption { display: flex; justify-content: space-between; color: #7C8593; font-size: 24rpx; margin-bottom: 22rpx; }
.filter-caption text { color: #0965F3; }
