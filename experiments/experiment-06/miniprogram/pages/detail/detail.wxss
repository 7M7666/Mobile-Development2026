.detail-meta { margin: 28rpx 0; color: #667085; font-size: 21rpx; letter-spacing: 2rpx; }
.actions { display: flex; flex-wrap: wrap; margin: 30rpx -5rpx; }
.actions button { flex: 1; margin: 5rpx; padding: 10rpx 12rpx; font-size: 24rpx; }
.save-picker { padding-top: 16rpx; }
.picker-grid { display: flex; flex-wrap: wrap; }
.picker-grid image { width: 31%; height: 210rpx; margin: 1%; border-radius: 10rpx; }

.comment-compose { display: flex; align-items: flex-end; padding: 20rpx; border-radius: 16rpx; background: #F4F6F9; margin-bottom: 26rpx; }
.comment-compose textarea { flex: 1; min-width: 0; max-height: 240rpx; padding: 12rpx 0; font-size: 27rpx; }
.comment-compose button { margin: 0 0 0 18rpx; padding: 2rpx 24rpx; font-size: 24rpx; }
.comment-row { display: flex; gap: 20rpx; padding: 25rpx 0; border-bottom: 1rpx solid #F0F1F4; }
.comment-body { flex: 1; min-width: 0; }
.comment-name { font-weight: 800; font-size: 26rpx; }
.comment-content { white-space: pre-wrap; word-break: break-all; margin: 7rpx 0 12rpx; }

.detail-meta { display:flex; align-items:center; justify-content:space-between; }
.delete-post { margin:0; padding:10rpx 0 10rpx 24rpx; background:transparent; color:#B65858; font-size:23rpx; line-height:1.5; }
