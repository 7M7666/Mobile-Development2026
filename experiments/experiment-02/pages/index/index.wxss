/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: #f7f7fb;
}

scroll-view {
  flex: 1;
  overflow-y: hidden;
}

image {
  width: calc(100% - 48rpx);
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx #d8d2ed;
}

.card {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #7868bd;
  letter-spacing: 4rpx;
}

.profile {
  padding: 38rpx 44rpx 72rpx;
  color: #484a5e;
  text-align: left;
}

.profile view {
  margin-bottom: 30rpx;
  font-size: 27rpx;
  line-height: 1.85;
  text-indent: 0;
}

.profile .title {
  margin-bottom: 36rpx;
  padding-left: 18rpx;
  border-left: 8rpx solid #6b46e5;
  font-weight: bold;
  font-size: 38rpx;
  line-height: 1.4;
  color: #5f3fd0;
  text-align: left;
  text-indent: 0;
}

.profile .motto {
  margin-top: 48rpx;
  margin-bottom: 10rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #ddd7f2;
  font-size: 22rpx;
  font-weight: bold;
  line-height: 1.6;
  color: #6b46e5;
  text-align: center;
  text-indent: 0;
  letter-spacing: 3rpx;
}
