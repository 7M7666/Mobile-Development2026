page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page {
  flex: 1;
  padding: 36rpx 30rpx 48rpx;
  box-sizing: border-box;
  background: #fff8eb;
}

.page-heading {
  display: flex;
  flex-direction: column;
  margin: 0 8rpx 28rpx;
}

.heading-title {
  color: #70412e;
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 3rpx;
}

.heading-copy {
  margin-top: 8rpx;
  color: #9a7253;
  font-size: 21rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.level-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.level-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin: 0;
  padding: 22rpx 24rpx;
  color: #70412e;
  background: #fffdf7;
  border: 4rpx solid #bd9268;
  border-radius: 16rpx;
  box-shadow: 0 6rpx 0 #ead0aa;
}

.level-card.locked {
  color: #a28a76;
  background: #eee2d2;
  border-color: #d3c2ad;
  box-shadow: none;
}

.level-main {
  display: flex;
  align-items: center;
}

.level-number {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  color: #fff8eb;
  font-size: 31rpx;
  font-weight: bold;
  background: #d57a48;
  border: 3rpx solid #70412e;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.locked .level-number {
  color: #eee2d2;
  background: #bca995;
  border-color: #a28a76;
}

.level-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
}

.best-records {
  display: flex;
  gap: 22rpx;
  margin: 18rpx 0 0 98rpx;
  color: #9a7253;
  font-size: 22rpx;
  line-height: 1.5;
  letter-spacing: 1rpx;
}

.level-title {
  display: block;
  color: #9a7253;
  font-size: 20rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.level-name {
  display: block;
  margin-top: 5rpx;
  font-size: 31rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
}

.level-status {
  padding: 7rpx 10rpx;
  color: #8f613f;
  font-size: 19rpx;
  font-weight: bold;
  background: #f5dfb7;
  border-radius: 8rpx;
  letter-spacing: 1rpx;
}

.locked .level-status {
  color: #a28a76;
  background: #e2d3c1;
}
