page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 24rpx 30rpx;
  box-sizing: border-box;
  background: #fff8eb;
}

.game-header {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: space-between;
}

.level-name {
  display: block;
  margin-top: 4rpx;
  color: #4a3425;
  font-size: 34rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.eyebrow,
.swipe-hint,
.stat-label {
  color: #9a7253;
  font-size: 20rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.game-sound-toggle {
  min-width: 152rpx;
  margin: 0;
  padding: 8rpx 10rpx;
  color: #70412e;
  font-size: 19rpx;
  font-weight: bold;
  line-height: 1.4;
  background: #fffdf7;
  border: 3rpx solid #bd9268;
  border-radius: 10rpx;
}

.stats {
  display: flex;
  width: 100%;
  gap: 12rpx;
  margin: 20rpx 0 16rpx;
}

.stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 4rpx;
  background: #fffdf7;
  border: 3rpx solid #e8c99a;
  border-radius: 12rpx;
  box-shadow: 4rpx 4rpx 0 #f2dfbf;
}

.stat-value {
  margin-top: 3rpx;
  color: #4a3425;
  font-size: 30rpx;
  font-weight: bold;
}

.game-canvas {
  width: 100%;
  height: 700rpx;
  background: #f5ead5;
  border: 6rpx solid #70513a;
  border-radius: 18rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 0 #d8b77f;
}

.swipe-hint {
  margin-top: 20rpx;
}

.actions {
  display: flex;
  width: 100%;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-button,
.clear-button {
  flex: 1;
  margin: 0;
  color: #70412e;
  font-size: 23rpx;
  font-weight: bold;
  background: #fffdf7;
  border: 3rpx solid #bd9268;
  border-radius: 12rpx;
}

.clear-overlay {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(74, 52, 37, 0.55);
}

.clear-panel {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 560rpx;
  padding: 34rpx 40rpx 26rpx;
  background: #fff8eb;
  border: 6rpx solid #70412e;
  border-radius: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 10rpx 0 #3f2a20;
}

.clear-cat {
  width: 128rpx;
  height: 128rpx;
  align-self: center;
}

.clear-meow {
  position: absolute;
  top: 38rpx;
  right: 42rpx;
  padding: 8rpx 12rpx;
  color: #4a3425;
  font-size: 20rpx;
  font-weight: bold;
  background: #fffdf7;
  border: 3rpx solid #70412e;
  border-radius: 10rpx;
}

.clear-title {
  margin: 6rpx 0 4rpx;
  color: #70412e;
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  letter-spacing: 2rpx;
}

.clear-subtitle {
  margin-bottom: 24rpx;
  color: #9a7253;
  font-size: 22rpx;
  font-weight: bold;
  text-align: center;
  letter-spacing: 1rpx;
}

.clear-stats {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin: 0 0 24rpx;
  padding: 20rpx;
  color: #70412e;
  font-size: 26rpx;
  text-align: center;
  background: #f5ead5;
  border-radius: 12rpx;
}

.clear-button {
  width: 100%;
  margin-bottom: 16rpx;
}

.clear-button:first-of-type {
  color: #fff8eb;
  background: #d57a48;
  border-color: #70412e;
}
