page { background: #9891F5; }.timeline-page { min-height: 100vh; padding: calc(env(safe-area-inset-top) + 28rpx) 32rpx calc(env(safe-area-inset-bottom) + 184rpx); box-sizing: border-box; color: #242522; font-family: Arial, "Helvetica Neue", "PingFang SC", sans-serif; }.top-line, .filter-row, .card-top, .card-bottom, .tag-row { display: flex; }.top-line { justify-content: space-between; font-size: 18rpx; font-weight: 900; letter-spacing: 1.5rpx; }.title { margin-top: 52rpx; font-size: 102rpx; font-weight: 900; letter-spacing: -7rpx; line-height: .78; }.title text { display: block; }.title text:last-child { width: fit-content; margin-top: 14rpx; padding: 7rpx 12rpx 15rpx; color: #ECEDE7; background: #242522; }.filter-row { gap: 12rpx; margin-top: 48rpx; }.filter { padding: 13rpx 20rpx; border: 3rpx solid #242522; font-size: 19rpx; font-weight: 900; letter-spacing: 1rpx; }.filter-on { color: #9891F5; background: #242522; }.journey-list { margin-top: 34rpx; }.journey-card { margin-top: 24rpx; padding: 22rpx; background: #ECEDE7; box-shadow: 12rpx 12rpx 0 #242522; }.journey-card:first-child { margin-top: 0; }.card-top { justify-content: space-between; color: #3C473D; font-size: 16rpx; font-weight: 900; letter-spacing: 1rpx; }.card-title { margin-top: 17rpx; }.card-title text:first-child { display: block; font-size: 42rpx; font-weight: 900; line-height: .82; letter-spacing: -2rpx; }.card-title text:last-child { display: block; margin-top: 8rpx; font-size: 20rpx; font-weight: 800; letter-spacing: 1rpx; }.cover { display: block; width: 100%; height: 310rpx; margin-top: 24rpx; background: #A7B59F; }.cover-empty { display: flex; align-items: center; justify-content: center; color: #3C473D; background: repeating-linear-gradient(-45deg, #D6D8D0 0, #D6D8D0 12rpx, #ECEDE7 12rpx, #ECEDE7 24rpx); font-size: 25rpx; font-weight: 900; line-height: .9; text-align: center; }.photo-strip { display: flex; gap: 8rpx; margin-top: 10rpx; overflow: hidden; }.strip-photo { width: 112rpx; height: 86rpx; flex: none; }.card-bottom { align-items: flex-end; justify-content: space-between; margin-top: 23rpx; }.memory-title { display: block; font-size: 23rpx; font-weight: 900; letter-spacing: .5rpx; }.memory-copy { display: block; max-width: 480rpx; margin-top: 7rpx; color: #3C473D; font-size: 17rpx; font-weight: 800; letter-spacing: .3rpx; }.card-arrow { color: #FF5944; font-size: 44rpx; font-weight: 900; }.tag-row { flex-wrap: wrap; gap: 8rpx; margin-top: 17rpx; }.tag-row text { padding: 5rpx 8rpx; border: 2rpx solid #242522; font-size: 16rpx; font-weight: 800; }.empty-filter { display: flex; min-height: 480rpx; flex-direction: column; justify-content: center; color: #242522; }.empty-filter text:first-child { font-size: 54rpx; font-weight: 900; line-height: .88; letter-spacing: -3rpx; }.empty-filter text:last-child { width: 390rpx; margin-top: 26rpx; font-size: 19rpx; font-weight: 800; letter-spacing: 1rpx; }.rise { opacity: 0; animation: rise .42s ease-out forwards; }.d1 { animation-delay: .08s; }.stagger > view { opacity: 0; animation: rise .42s ease-out forwards; }.stagger > view:nth-child(1) { animation-delay: .05s; }.stagger > view:nth-child(2) { animation-delay: .12s; }.stagger > view:nth-child(3) { animation-delay: .19s; }.stagger > view:nth-child(4) { animation-delay: .26s; }@keyframes rise { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }
page { height: 100vh; overflow: hidden; }.page-scroll { display: block; width: 100%; height: 100%; box-sizing: border-box; }
 .journey-cn { display: block; margin-top: 24rpx; color: #3C473D; font-size: 19rpx; font-weight: 700; line-height: 1.25; }.timeline-page .filter-row { margin-top: 30rpx; }
.journey-modes { display: flex; margin-top: 30rpx; border: 3rpx solid #242522; }
.journey-mode { flex: 1; padding: 24rpx 12rpx; text-align: center; }
.journey-mode text { display: block; font-size: 30rpx; font-weight: 900; }
.journey-mode text:last-child { margin-top: 8rpx; font-size: 18rpx; letter-spacing: 1rpx; }
.mode-selected { color: #ECEDE7; background: #242522; }
.your-journey { margin-top: 30rpx; }
.route-question { display: block; margin-top: 36rpx; font-size: 29rpx; font-weight: 900; line-height: 1.5; }
.route-help { display: block; margin-top: 16rpx; color: #242522; font-size: 23rpx; line-height: 1.6; }
.route-options { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.route-option { padding: 20rpx 24rpx; border: 2rpx solid #242522; background: #ECEDE7; font-size: 27rpx; font-weight: 800; }
.route-option text { font-size: 17rpx; }
.option-selected { color: #A8D900; background: #242522; }
.route-sort-list { margin-top: 24rpx; }
.route-sort-card { display: flex; align-items: center; min-height: 120rpx; margin-top: 12rpx; border: 3rpx solid #242522; box-sizing: border-box; background: #ECEDE7; }
.route-handle { display: flex; flex-direction: column; justify-content: center; align-items: center; width: 80rpx; height: 120rpx; flex-shrink: 0; }
.route-handle text:first-child { font-size: 40rpx; }
.route-handle text:last-child { font-size: 21rpx; }
.route-thumb { width: 84rpx; height: 90rpx; flex-shrink: 0; }
.route-stop-name { flex: 1; min-width: 0; padding: 10rpx 14rpx; }
.route-stop-name text { display: block; font-size: 27rpx; font-weight: 900; }
.route-stop-name text:last-child { margin-top: 10rpx; font-size: 17rpx; font-weight: 600; }
.route-skip { padding: 26rpx 18rpx; flex-shrink: 0; }
.route-skip text { display: block; font-size: 23rpx; }
.route-skip text:last-child { margin-top: 8rpx; font-size: 16rpx; }
.route-pressed { opacity: .7; }
.route-dragging { opacity: 1; background: #A8D900; border-style: dashed; }
.route-drop-target { border-color: #FF5944; background: #D8D4FF; }
.route-skipped { margin-top: 24rpx; border-top: 2rpx solid #242522; }
.skipped-stop { display: flex; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #242522; font-size: 26rpx; }
.skipped-stop view { padding: 26rpx 12rpx; font-size: 23rpx; font-weight: 800; }
.route-error { display: block; padding-top: 20rpx; color: #751B12; font-size: 25rpx; font-weight: 800; }
.route-save { margin-top: 28rpx; padding: 28rpx; color: #ECEDE7; background: #242522; font-size: 30rpx; font-weight: 900; }
.route-output { margin-top: 36rpx; padding: 24rpx; background: #ECEDE7; border-top: 8rpx solid #242522; }
.route-output-title { display: block; font-size: 32rpx; font-weight: 900; }
.route-section-label { display: block; margin-top: 22rpx; margin-bottom: 16rpx; font-size: 21rpx; font-weight: 800; }
.route-day { padding: 24rpx 0; border-bottom: 2rpx solid #242522; }
.route-day text { display: block; font-size: 21rpx; }
.route-day text:last-child { margin-top: 10rpx; font-size: 36rpx; font-weight: 900; }
.route-compare { margin-top: 36rpx; font-size: 26rpx; line-height: 1.7; }
.route-ending { display: block; margin-top: 36rpx; font-size: 28rpx; font-weight: 900; }
