page { background: #9891F5; }.timeline-page { min-height: 100vh; padding: calc(env(safe-area-inset-top) + 28rpx) 32rpx calc(env(safe-area-inset-bottom) + 184rpx); box-sizing: border-box; color: #242522; font-family: Arial, "Helvetica Neue", "PingFang SC", sans-serif; }.top-line, .filter-row, .card-top, .card-bottom, .tag-row { display: flex; }.top-line { justify-content: space-between; font-size: 18rpx; font-weight: 900; letter-spacing: 1.5rpx; }.title { margin-top: 52rpx; font-size: 102rpx; font-weight: 900; letter-spacing: -7rpx; line-height: .78; }.title text { display: block; }.title text:last-child { width: fit-content; margin-top: 14rpx; padding: 7rpx 12rpx 15rpx; color: #ECEDE7; background: #242522; }.filter-row { gap: 12rpx; margin-top: 48rpx; }.filter { padding: 13rpx 20rpx; border: 3rpx solid #242522; font-size: 19rpx; font-weight: 900; letter-spacing: 1rpx; }.filter-on { color: #9891F5; background: #242522; }.journey-list { margin-top: 34rpx; }.journey-card { margin-top: 24rpx; padding: 22rpx; background: #ECEDE7; box-shadow: 12rpx 12rpx 0 #242522; }.journey-card:first-child { margin-top: 0; }.card-top { justify-content: space-between; color: #3C473D; font-size: 16rpx; font-weight: 900; letter-spacing: 1rpx; }.card-title { margin-top: 17rpx; }.card-title text:first-child { display: block; font-size: 42rpx; font-weight: 900; line-height: .82; letter-spacing: -2rpx; }.card-title text:last-child { display: block; margin-top: 8rpx; font-size: 20rpx; font-weight: 800; letter-spacing: 1rpx; }.cover { display: block; width: 100%; height: 310rpx; margin-top: 24rpx; background: #A7B59F; }.cover-empty { display: flex; align-items: center; justify-content: center; color: #3C473D; background: repeating-linear-gradient(-45deg, #D6D8D0 0, #D6D8D0 12rpx, #ECEDE7 12rpx, #ECEDE7 24rpx); font-size: 25rpx; font-weight: 900; line-height: .9; text-align: center; }.photo-strip { display: flex; gap: 8rpx; margin-top: 10rpx; overflow: hidden; }.strip-photo { width: 112rpx; height: 86rpx; flex: none; }.card-bottom { align-items: flex-end; justify-content: space-between; margin-top: 23rpx; }.memory-title { display: block; font-size: 23rpx; font-weight: 900; letter-spacing: .5rpx; }.memory-copy { display: block; max-width: 480rpx; margin-top: 7rpx; color: #3C473D; font-size: 17rpx; font-weight: 800; letter-spacing: .3rpx; }.card-arrow { color: #FF5944; font-size: 44rpx; font-weight: 900; }.tag-row { flex-wrap: wrap; gap: 8rpx; margin-top: 17rpx; }.tag-row text { padding: 5rpx 8rpx; border: 2rpx solid #242522; font-size: 16rpx; font-weight: 800; }.empty-filter { display: flex; min-height: 480rpx; flex-direction: column; justify-content: center; color: #242522; }.empty-filter text:first-child { font-size: 54rpx; font-weight: 900; line-height: .88; letter-spacing: -3rpx; }.empty-filter text:last-child { width: 390rpx; margin-top: 26rpx; font-size: 19rpx; font-weight: 800; letter-spacing: 1rpx; }.rise { opacity: 0; animation: rise .42s ease-out forwards; }.d1 { animation-delay: .08s; }.stagger > view { opacity: 0; animation: rise .42s ease-out forwards; }.stagger > view:nth-child(1) { animation-delay: .05s; }.stagger > view:nth-child(2) { animation-delay: .12s; }.stagger > view:nth-child(3) { animation-delay: .19s; }.stagger > view:nth-child(4) { animation-delay: .26s; }@keyframes rise { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }
