page { background: #ECEDE7; }.archive { min-height: 100vh; padding: calc(env(safe-area-inset-top) + 28rpx) 32rpx calc(env(safe-area-inset-bottom) + 184rpx); box-sizing: border-box; color: #242522; font-family: Arial, "Helvetica Neue", "PingFang SC", sans-serif; }.archive-head, .section-head, .wrapped-entry, .cut-entry, .tool { display: flex; }.archive-head { justify-content: space-between; font-size: 17rpx; font-weight: 900; letter-spacing: 1.5rpx; }.archive-head text:last-child { color: #FF5944; }.archive-title { margin-top: 56rpx; font-size: 104rpx; font-weight: 900; line-height: .75; letter-spacing: -8rpx; }.archive-title text { display: block; }.archive-title text:last-child { width: fit-content; margin-top: 20rpx; padding: 10rpx 14rpx 16rpx; color: #ECEDE7; background: #242522; }.archive-ledger { display: flex; flex-direction: column; gap: 8rpx; margin-top: 56rpx; padding: 18rpx 0; border-top: 4rpx solid #242522; border-bottom: 4rpx solid #242522; font-size: 20rpx; font-weight: 900; letter-spacing: 1.1rpx; }.archive-ledger text:last-child { color: #FF5944; }
.archive-collage { position: relative; height: 650rpx; margin-top: 34rpx; overflow: hidden; background: #3C473D; }.archive-photo { position: absolute; border: 5rpx solid #242522; box-sizing: border-box; }.archive-photo-0 { top: 0; left: 0; width: 382rpx; height: 338rpx; }.archive-photo-1 { top: 38rpx; right: -26rpx; width: 280rpx; height: 236rpx; transform: rotate(5deg); }.archive-photo-2 { top: 292rpx; right: 0; width: 368rpx; height: 326rpx; }.archive-photo-3 { bottom: -48rpx; left: -30rpx; width: 346rpx; height: 286rpx; transform: rotate(-4deg); }.archive-photo-4 { top: 244rpx; left: 228rpx; width: 194rpx; height: 160rpx; transform: rotate(-8deg); }.archive-stamp { position: absolute; top: 244rpx; left: 42rpx; display: flex; flex-direction: column; padding: 12rpx; color: #242522; background: #A8D900; font-size: 42rpx; font-weight: 900; line-height: .78; letter-spacing: -2rpx; transform: rotate(-6deg); }
.section-head { justify-content: space-between; margin-top: 58rpx; padding-bottom: 13rpx; border-bottom: 3rpx solid #242522; font-size: 18rpx; font-weight: 900; letter-spacing: 1.5rpx; }.section-head text:last-child { color: #3C473D; }.place-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 16rpx; }.place-card { position: relative; height: 260rpx; overflow: hidden; background: #9891F5; }.place-card image { width: 100%; height: 100%; }.place-card > view { position: absolute; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; padding: 14rpx; color: #ECEDE7; background: linear-gradient(transparent, #242522E8); }.place-card text:first-child { color: #A8D900; font-size: 17rpx; font-weight: 900; }.place-card text:nth-child(2) { margin-top: 4rpx; font-size: 31rpx; font-weight: 900; line-height: .84; letter-spacing: -2rpx; }.place-card text:last-child { margin-top: 8rpx; font-size: 16rpx; font-weight: 900; letter-spacing: 1rpx; }
.moment-list { margin-top: 16rpx; }.moment-row { display: flex; min-height: 124rpx; align-items: center; border-bottom: 2rpx solid #242522; }.moment-row image { width: 98rpx; height: 98rpx; }.moment-row view { display: flex; flex-direction: column; margin-left: 18rpx; }.moment-row text:first-child { color: #FF5944; font-size: 17rpx; font-weight: 900; letter-spacing: 1rpx; }.moment-row text:last-child { margin-top: 6rpx; font-size: 25rpx; font-weight: 900; line-height: .95; letter-spacing: -1rpx; }.archive-tools { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 54rpx; }.tool { min-height: 176rpx; flex-direction: column; justify-content: space-between; padding: 18rpx; box-sizing: border-box; font-size: 29rpx; font-weight: 900; line-height: .88; letter-spacing: -1rpx; }.tool text:last-child { font-size: 16rpx; letter-spacing: 1rpx; }.soundtrack { color: #ECEDE7; background: #242522; }.soundtrack text:last-child { color: #A8D900; }.type { background: #9891F5; }.wrapped-entry, .cut-entry { align-items: center; justify-content: space-between; min-height: 102rpx; margin-top: 18rpx; padding: 0 20rpx; box-sizing: border-box; font-size: 24rpx; font-weight: 900; letter-spacing: .5rpx; }.wrapped-entry { margin-top: 54rpx; color: #ECEDE7; background: #242522; }.wrapped-entry text:last-child { color: #A8D900; font-size: 44rpx; }.cut-entry { color: #242522; background: #FF5944; }.cut-entry text:last-child { max-width: 260rpx; font-size: 16rpx; letter-spacing: 1rpx; text-align: right; }
page { height: 100vh; overflow: hidden; }.page-scroll { display: block; width: 100%; height: 100%; box-sizing: border-box; }.archive-ledger .archive-cn { margin-top: 8rpx; color: #3C473D; font-size: 18rpx; font-weight: 700; letter-spacing: 0; line-height: 1.25; }
