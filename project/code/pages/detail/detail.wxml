<scroll-view class="page-scroll" scroll-y enable-flex="true" show-scrollbar="false">
<view class="detail-page theme-{{journey.theme}}" style="background: {{journey.themeColor}};">
  <view class="detail-top"><view class="back" bindtap="goBack"><text>← BACK</text></view><text>SUMMER STOP</text></view>
  <view wx:if="{{error}}" class="detail-error"><text>THIS STOP ISN'T IN THE ROUTE.</text></view>
  <block wx:else>
    <view class="place-title rise"><text>{{journey.name}}</text><text wx:if="{{journey.city}}">{{journey.city}}</text></view>
    <view class="place-meta rise d1"><text>STOP {{journey.order}}</text><text>{{journey.dateLabel}}</text><text>{{journey.province || 'PROVINCE PENDING'}}</text></view>
    <image wx:if="{{journey.coverPhoto}}" class="hero-photo rise d2" style="border: 8rpx solid #242522; box-sizing: border-box;" src="{{journey.coverPhoto.src}}" mode="aspectFill" bindtap="previewPhoto" data-src="{{journey.coverPhoto.src}}"></image>
    <view wx:else class="hero-photo hero-empty rise d2"><text>THIS STOP'S<br/>COVER IS NEXT.</text></view>
    <view class="note-block"><text class="note-kicker">JOURNEY NOTE</text><text wx:if="{{journey.intro}}" class="note-copy">{{journey.intro}}</text><text wx:else class="note-copy">这一站的旅程记录收在照片里。</text><text class="note-cn">这一站留下的照片，按真实比例重新排成一段小型旅行记录。</text></view>
    <view wx:if="{{topMoment}}" class="moment-block"><text>TOP MOMENT</text><text>{{topMoment.title}}</text></view>
    <view wx:if="{{tags.length}}" class="tag-list"><text wx:for="{{tags}}" wx:key="*this">#{{item}}</text></view>
    <block wx:if="{{galleryRows.length}}">
      <view class="section-title"><text>SELECTED PHOTOS</text><text>{{selectedPhotos.length}}</text></view>
      <view class="photo-gallery">
        <view wx:for="{{galleryRows}}" wx:for-item="row" wx:key="key" class="gallery-row" style="height: {{row.height}}rpx;">
          <view wx:for="{{row.photos}}" wx:for-item="photo" wx:key="id" class="gallery-cell" style="width: {{photo.width}}rpx; height: {{row.height}}rpx;">
            <image class="detail-photo" src="{{photo.src}}" mode="aspectFit" bindtap="previewPhoto" data-src="{{photo.src}}"></image>
          </view>
        </view>
      </view>
    </block>
    <view wx:if="{{situation}}" class="situation">
      <text class="situation-title">如果当时是你，你会怎么选？</text>
      <text class="situation-kicker">WHAT WOULD YOU DO?</text>
      <text wx:if="{{situation.time}}" class="situation-time">{{situation.time}}</text>
      <text class="situation-scene">{{situation.scene}}</text>
      <text class="situation-question">{{situation.question}}</text>
      <view wx:if="{{choosing}}" class="situation-options">
        <view wx:for="{{situation.choices}}" wx:key="id" class="situation-option {{decision.choice === item.id ? 'situation-last' : ''}}" data-choice="{{item.id}}" bindtap="selectDecision" hover-class="situation-pressed"><text>{{item.label}}</text><text>{{decision.choice === item.id ? '上次选择' : '选择 →'}}</text></view>
      </view>
      <view wx:else class="situation-result">
        <view class="situation-you"><text class="situation-kicker">{{decisionRestored ? '你上次选择了' : '你的选择'}} · YOU</text><text class="situation-answer">{{decision.label}}</text></view>
        <view class="situation-me"><text class="situation-kicker">我的选择 · ME</text><text class="situation-answer">{{decision.comparisonLabel}}</text><text class="situation-caption">我的互动对照版本</text></view>
        <view class="situation-verdict"><text>{{decision.same ? '我们会做同一个选择。' : '这里，我们会走向两个不同的版本。'}}</text><text class="situation-kicker">{{decision.same ? 'SAME CHOICE.' : 'DIFFERENT CHOICE.'}}</text></view>
        <view class="situation-reselect" bindtap="reselectDecision">重新选择 →</view>
        <text wx:if="{{decisionSaveNotice}}" class="situation-caption">{{decisionSaveNotice}}</text>
      </view>
    </view>
  </block>
</view>

</scroll-view>

<app-nav active=""></app-nav>
