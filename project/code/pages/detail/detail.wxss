page { background: #A8D900; }.detail-page { min-height: 100vh; padding: calc(env(safe-area-inset-top) + 26rpx) 32rpx calc(env(safe-area-inset-bottom) + 210rpx); box-sizing: border-box; color: #242522; font-family: Arial, "Helvetica Neue", "PingFang SC", sans-serif; }.detail-top, .place-meta, .section-title { display: flex; }.detail-top { align-items: center; justify-content: space-between; font-size: 18rpx; font-weight: 900; letter-spacing: 1.5rpx; }.back { padding: 8rpx 10rpx; color: #ECEDE7; background: #242522; }.place-title { margin-top: 56rpx; font-size: 86rpx; font-weight: 900; line-height: .78; letter-spacing: -6rpx; }.place-title text { display: block; }.place-title text:last-child { margin-top: 18rpx; font-size: 32rpx; letter-spacing: -1rpx; }.place-meta { flex-wrap: wrap; gap: 12rpx; margin-top: 36rpx; }.place-meta text { padding: 6rpx 9rpx; border: 3rpx solid #242522; font-size: 17rpx; font-weight: 900; letter-spacing: .8rpx; }.hero-photo { display: block; width: 100%; height: 500rpx; margin-top: 30rpx; background: #9891F5; }.hero-empty { display: flex; align-items: center; justify-content: center; background: repeating-linear-gradient(45deg, #B9E94A 0, #B9E94A 14rpx, #A8D900 14rpx, #A8D900 28rpx); font-size: 44rpx; font-weight: 900; line-height: .84; letter-spacing: -2rpx; text-align: center; }.note-block { margin-top: 34rpx; padding-top: 18rpx; border-top: 4rpx solid #242522; }.note-kicker { display: block; font-size: 17rpx; font-weight: 900; letter-spacing: 1.5rpx; }.note-copy { display: block; margin-top: 13rpx; font-size: 31rpx; font-weight: 900; line-height: .98; letter-spacing: -1rpx; }.note-pending { color: #3C473D; }.moment-block { margin-top: 30rpx; padding: 18rpx; color: #ECEDE7; background: #242522; }.moment-block text:first-child { display: block; color: #A8D900; font-size: 16rpx; font-weight: 900; letter-spacing: 1rpx; }.moment-block text:last-child { display: block; margin-top: 7rpx; font-size: 28rpx; font-weight: 900; letter-spacing: -1rpx; }.tag-list { display: flex; flex-wrap: wrap; gap: 9rpx; margin-top: 25rpx; }.tag-list text { padding: 7rpx 10rpx; border: 3rpx solid #242522; font-size: 17rpx; font-weight: 800; }.section-title { justify-content: space-between; margin-top: 50rpx; padding-bottom: 12rpx; border-bottom: 3rpx solid #242522; font-size: 18rpx; font-weight: 900; letter-spacing: 1px; }.photo-gallery { margin-top: 18rpx; }.gallery-row { display: flex; gap: 12rpx; align-items: flex-start; margin-top: 12rpx; }.gallery-row:first-child { margin-top: 0; }.gallery-cell { flex: none; overflow: hidden; background: #3C473D; }.detail-photo { display: block; width: 100%; height: 100%; }.detail-error { display: flex; min-height: 70vh; align-items: center; font-size: 56rpx; font-weight: 900; line-height: .85; letter-spacing: -4rpx; }.rise { opacity: 0; animation: rise .42s ease-out forwards; }.d1 { animation-delay: .08s; }.d2 { animation-delay: .16s; }@keyframes rise { from { opacity: 0; transform: translateY(18rpx); } to { opacity: 1; transform: translateY(0); } }
page { height: 100vh; overflow: hidden; }.page-scroll { display: block; width: 100%; height: 100%; box-sizing: border-box; }.note-cn { display: block; margin-top: 12rpx; color: #3C473D; font-size: 18rpx; font-weight: 700; line-height: 1.2; }
.situation { margin-top: 48rpx; padding: 28rpx; border-top: 8rpx solid #242522; background: #ECEDE7; }
.situation-title { display: block; font-size: 34rpx; font-weight: 900; line-height: 1.5; }
.situation-kicker { display: block; margin-top: 14rpx; font-size: 19rpx; font-weight: 800; letter-spacing: 1rpx; }
.situation-time { display: block; margin-top: 32rpx; font-size: 90rpx; font-weight: 900; letter-spacing: -5rpx; }
.situation-scene { display: block; margin-top: 30rpx; font-size: 31rpx; line-height: 1.7; }
.situation-question { display: block; margin-top: 16rpx; font-size: 25rpx; }
.situation-options { margin-top: 24rpx; }
.situation-option { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 28rpx 18rpx; margin-top: 12rpx; border: 2rpx solid #242522; font-size: 28rpx; font-weight: 800; }
.situation-option text:last-child { flex-shrink: 0; font-size: 20rpx; }
.situation-last { background: #A8D900; }
.situation-pressed { transform: scale(.98); background: #A8D900; }
.situation-you { margin-top: 30rpx; padding: 24rpx; background: #242522; color: #ECEDE7; animation: situationReveal .25s ease-out both; }
.situation-you .situation-kicker { color: #A8D900; }
.situation-me { padding: 24rpx 0; border-bottom: 2rpx solid #242522; animation: situationReveal .3s .08s ease-out both; }
.situation-answer { display: block; margin-top: 18rpx; font-size: 40rpx; font-weight: 900; line-height: 1.4; }
.situation-caption { display: block; margin-top: 16rpx; font-size: 22rpx; color: #3C473D; line-height: 1.6; }
.situation-verdict { padding: 28rpx 0; font-size: 28rpx; font-weight: 800; line-height: 1.6; animation: situationReveal .3s .16s ease-out both; }
.situation-reselect { padding: 22rpx 0; font-size: 26rpx; font-weight: 800; }
@keyframes situationReveal { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
