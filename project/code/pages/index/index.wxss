.day-edition-choice { padding:18rpx; margin-top:20rpx; background:#242522; color:#ECEDE7; }.day-edition-choice > text { display:block; font-size:21rpx; line-height:1.5; }
.day-edition-choice > view { display:flex; flex-direction:row; margin:14rpx 0; }.day-edition-choice > view > view { width:50%; box-sizing:border-box; padding-right:12rpx; }
.day-edition-choice > view > view:last-child { padding-left:14rpx; border-left:2rpx solid #A8D900; color:#A8D900; }
.day-edition-choice > view text { display:block; font-size:20rpx; line-height:1.4; }.day-edition-choice > view text:last-child { font-size:29rpx; margin-top:8rpx; font-weight:900; }

.wrapped-edition .days-strip text { color:#ECEDE7; }
.wrapped-edition .days-tick-on { background:#242522; }
.story-detail-entry { display:flex; flex-direction:row; justify-content:space-between; align-items:center; flex-shrink:0; margin-top:24rpx; padding:26rpx 22rpx; box-sizing:border-box; border:3rpx solid #242522; background:#242522; color:#A8D900; font-size:28rpx; font-weight:900; line-height:1.4; }
.story-detail-entry > text:first-child { flex:1; min-width:0; }.story-detail-entry > text:last-child { flex-shrink:0; margin-left:18rpx; font-size:23rpx; }
.planned-reality > .story-detail-entry { margin:24rpx 32rpx; }
.story-detail-overlay { position:fixed; top:0; right:0; bottom:0; left:0; z-index:100; }
.story-detail-scrim { position:absolute; top:0; right:0; bottom:0; left:0; background:rgba(0,0,0,.5); }
.story-detail-sheet { position:absolute; left:0; right:0; bottom:0; height:76%; box-sizing:border-box; display:flex; flex-direction:column; background:#ECEDE7; color:#242522; border-top:8rpx solid #A8D900; }
.story-detail-heading { display:flex; flex-direction:row; align-items:center; justify-content:space-between; padding:20rpx 28rpx; border-bottom:3rpx solid #242522; flex-shrink:0; font-size:23rpx; font-weight:900; }
.story-detail-heading > view { padding:16rpx; }
.story-detail-scroll { height:0; flex:1; width:100%; min-height:0; }
.story-detail-scroll .wrapped-note { margin:24rpx; padding:24rpx 0; }.story-detail-scroll .plan-visitor-story { margin:24rpx; }.story-detail-scroll .day-edition-choice { margin:24rpx; }
.story-detail-scroll .wrapped-preview-photo { height:420rpx; }
