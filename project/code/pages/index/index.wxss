page {
  font-family: Arial, "Helvetica Neue", "PingFang SC", sans-serif;
}

page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #ECEDE7;
}

.story {
  position: relative;
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: background 180ms ease-out;
}

.theme-cover,
.theme-placeholder {
  background: #ECEDE7;
}

.theme-biggest {
  background: #9891F5;
}

.theme-planned-reality {
  background: #E9C52C;
}

.theme-summer-type {
  background: #9891F5;
}

.progress {
  position: relative;
  z-index: 3;
  flex: none;
  display: flex;
  gap: 6rpx;
  padding: 16rpx 96rpx 16rpx 24rpx;
}

.bar {
  flex: 1;
  height: 5rpx;
  opacity: 1;
}

.progress-dark .bar {
  background: #242522;
}

.progress-light .bar {
  background: #ECEDE7;
}

.bar.upcoming {
  opacity: 0.24;
}

.main {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.tap-area {
  position: absolute;
  z-index: 30;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
}

/* Wrapped: direct page gestures replace the old full-screen tap overlay. */
.tap-area { display: none; }
