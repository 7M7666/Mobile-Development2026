page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f2f2f2;
}

.story {
  width: 100%;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.progress {
  position: relative;
  z-index: 3;
  flex: none;
  display: flex;
  gap: 6rpx;
  padding: 16rpx 24rpx;
}

.bar {
  flex: 1;
  height: 6rpx;
  background: #d6d6d6;
}

.done {
  background: #242424;
}

.current {
  background: #777777;
}

.upcoming {
  background: #d6d6d6;
}

.main {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
}

.slide {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 48rpx;
  box-sizing: border-box;
  color: #242424;
  text-align: center;
}

.slide-num {
  font-size: 64rpx;
  font-weight: 700;
}

.slide-name {
  font-size: 40rpx;
  font-weight: 600;
}

.slide-index {
  font-size: 24rpx;
  color: #777777;
}

.tap-area {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
}

.tap-left,
.tap-right {
  height: 100%;
}

.tap-left {
  width: 30%;
}

.tap-right {
  width: 70%;
}
