.tap-left,
.tap-right {
  height: 100%;
}

.tap-left {
  width: 30%;
}

.tap-right {
  width: 70%;
}

.page {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.eyebrow,
.big-eyebrow,
.type-eyebrow,
.placeholder-label,
.type-placeholder,
.report-note {
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.en-copy {
  word-break: keep-all;
  overflow-wrap: normal;
}

.dots {
  display: flex;
  flex-wrap: wrap;
  width: 112rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  margin: 7rpx;
  border-radius: 50%;
}

.ring {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.ring-1 {
  width: 430rpx;
  height: 430rpx;
  background: #242522;
}

.ring-2 {
  width: 350rpx;
  height: 350rpx;
  background: #ECEDE7;
}

.ring-3 {
  width: 270rpx;
  height: 270rpx;
  background: #242522;
}

.ring-4 {
  width: 190rpx;
  height: 190rpx;
  background: #ECEDE7;
}

.ring-5 {
  width: 110rpx;
  height: 110rpx;
  background: #A8D900;
}

.scribble {
  position: absolute;
}

.scribble .line {
  position: absolute;
  left: 0;
  height: 3rpx;
  background: #242522;
  transform-origin: left center;
}

.scribble .line-1 {
  width: 240rpx;
  transform: rotate(12deg);
}

.scribble .line-2 {
  top: 38rpx;
  left: 34rpx;
  width: 260rpx;
  transform: rotate(-11deg);
}

.scribble .line-3 {
  top: 72rpx;
  left: 6rpx;
  width: 210rpx;
  transform: rotate(16deg);
}

/* Cover */
.cover {
  display: flex;
  flex-direction: column;
  padding: 28rpx 40rpx 32rpx;
  color: #242522;
  background: #ECEDE7;
}

.cover-head {
  position: relative;
  z-index: 3;
  align-self: flex-start;
  padding: 12rpx 16rpx 10rpx;
  color: #ECEDE7;
  background: #242522;
}

.cover-head .eyebrow {
  display: block;
  line-height: 1.05;
}

.cover-title {
  position: relative;
  z-index: 3;
  margin-top: 40rpx;
}

.cover-title text {
  display: block;
  font-size: 102rpx;
  font-weight: 900;
  line-height: 0.84;
  letter-spacing: -6rpx;
}

.cover-summer {
  animation: cover-summer 450ms ease-out both;
}

.cover-wrapped {
  width: 620rpx;
  margin-top: 14rpx;
  padding: 10rpx 14rpx 14rpx;
  box-sizing: border-box;
  color: #ECEDE7;
  background: #242522;
  animation: cover-wrapped 480ms 120ms ease-out both;
}

.cover-year {
  position: relative;
  z-index: 3;
  display: block;
  align-self: flex-end;
  margin-top: 22rpx;
  color: #A8D900;
  font-size: 194rpx;
  font-weight: 900;
  line-height: 0.8;
  letter-spacing: -12rpx;
  animation: cover-year 520ms 250ms ease-out both;
}

.cover-rings {
  position: absolute;
  z-index: 1;
  top: 250rpx;
  right: -190rpx;
  width: 430rpx;
  height: 430rpx;
  animation: ring-drift 1200ms 150ms ease-out both;
}

.cover-dots {
  position: absolute;
  z-index: 2;
  top: 32rpx;
  right: 28rpx;
}

.cover-dots .dot {
  background: #FF5944;
}

.cover-line {
  z-index: 2;
  right: -30rpx;
  bottom: 300rpx;
  width: 290rpx;
  height: 100rpx;
}

.cover-bottom {
  position: relative;
  z-index: 4;
  margin-top: auto;
  animation: cover-bottom 420ms 620ms ease-out both;
}

.metrics {
  display: flex;
  padding-top: 18rpx;
  border-top: 4rpx solid #242522;
}

.metric {
  flex: 1;
}

.metric-num,
.metric-name {
  display: block;
}

.metric-num {
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.metric-name {
  margin-top: 5rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.start {
  position: relative;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 224rpx;
  height: 78rpx;
  margin-top: 24rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  color: #ECEDE7;
  background: #242522;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.start-arrow {
  color: #A8D900;
  font-size: 36rpx;
}

/* Intro */
.intro {
  display: flex;
  flex-direction: column;
  padding: 30rpx 40rpx;
  color: #ECEDE7;
  background: #242522;
}

.intro-label,
.days-label,
.days-note,
.timeline-label,
.timeline-date,
.places-label {
  position: relative;
  z-index: 3;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.intro-label {
  display: block;
  align-self: flex-start;
  padding: 9rpx 13rpx;
  color: #242522;
  background: #A8D900;
}

.intro-title {
  position: relative;
  z-index: 3;
  margin-top: 132rpx;
}

.intro-title text {
  display: block;
  white-space: nowrap;
  font-size: 88rpx;
  font-weight: 900;
  line-height: 0.84;
  letter-spacing: -5rpx;
  opacity: 0;
  animation: intro-title-in 420ms ease-out both;
}

.intro-title text:nth-child(2) {
  margin-top: 20rpx;
  font-size: 90rpx;
  animation-delay: 100ms;
}

.intro-title text:last-child {
  margin-top: 14rpx;
  color: #A8D900;
  font-size: 106rpx;
  letter-spacing: -6rpx;
  animation-delay: 200ms;
}

.intro-dots {
  position: absolute;
  z-index: 2;
  top: 36rpx;
  right: 28rpx;
}

.intro-dots .dot {
  background: #FF5944;
}

.intro-stripes {
  position: absolute;
  z-index: 1;
  right: -184rpx;
  bottom: 70rpx;
  width: 500rpx;
  height: 360rpx;
  transform: rotate(-18deg);
}

.intro-stripe {
  position: absolute;
  right: 0;
  width: 100%;
  height: 58rpx;
  background: #ECEDE7;
}

.intro-stripe.stripe-1 {
  top: 10rpx;
}

.intro-stripe.stripe-2 {
  top: 132rpx;
}

.intro-stripe.stripe-3 {
  top: 254rpx;
}

.intro-line {
  z-index: 3;
  bottom: 148rpx;
  left: 46rpx;
  width: 240rpx;
}

.intro-line .line {
  background: #A8D900;
}

/* Days */
