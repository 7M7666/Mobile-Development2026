page { height: 100vh; background: #ECEDE7; font-family: Arial, "PingFang SC", sans-serif; }
.cut { height: 100vh; box-sizing: border-box; overflow: hidden; color: #242522; background: #ECEDE7; }
.cut-scroll { height: 100%; box-sizing: border-box; padding: 24rpx 36rpx 48rpx; }
.cut-mark, .actions, .footer, .sheet-head { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.cut-mark { font-size: 18rpx; font-weight: 900; letter-spacing: 1rpx; }
.back { background: #242522; color: #ECEDE7; padding: 12rpx; }
.cut-title { margin: 50rpx 0 36rpx; font-weight: 900; letter-spacing: -5rpx; line-height: .9; }
.cut-title text { display: block; font-size: 82rpx; }
.cut-title text:last-child { margin-top: 14rpx; background: #242522; color: #ECEDE7; padding: 12rpx; font-size: 62rpx; }
.steps { display: flex; border-top: 3rpx solid; border-bottom: 3rpx solid; }
.step { width: 25%; padding: 18rpx 6rpx; font-size: 16rpx; font-weight: 800; }
.step text { display: block; }.step text:first-child { font-size: 25rpx; margin-bottom: 8rpx; }.step-on { background: #A8D900; }
.section-title { display: block; font-size: 42rpx; line-height: 1.35; font-weight: 900; margin: 38rpx 0 16rpx; }
.caption { display: block; font-size: 24rpx; line-height: 1.6; margin: 18rpx 0; color: #465047; }.notice { display: block; padding: 20rpx; background: #E9C52C; margin-top: 20rpx; font-size: 26rpx; }
.recommendations { display: flex; flex-wrap: wrap; gap: 20rpx; margin-top: 28rpx; }.recommendation { width: calc(50% - 10rpx); }.recommendation image { width: 100%; height: 280rpx; }.photo-label { display: block; font-size: 19rpx; font-weight: 900; margin: 12rpx 0; }.photo-title { display: block; font-size: 25rpx; min-height: 68rpx; }
.actions { margin-top: 14rpx; }.actions > view { flex: 1; padding: 20rpx 8rpx; text-align: center; border: 2rpx solid #242522; font-size: 25rpx; font-weight: 800; }.actions > view:first-child { background: #A8D900; }.primary { padding: 26rpx; margin-top: 32rpx; background: #242522; color: #ECEDE7; font-size: 29rpx; font-weight: 800; }
.piece-types { display: flex; gap: 12rpx; margin: 28rpx 0; }.piece-types > view { flex: 1; border: 2rpx solid; padding: 24rpx 12rpx; }.piece-types text { display: block; font-size: 30rpx; font-weight: 800; }.piece-types text:last-child { font-size: 17rpx; margin-top: 9rpx; }
.piece-editor, .piece-preview { padding: 22rpx; border: 2rpx solid; margin-top: 22rpx; }.piece-editor textarea { width: 100%; min-height: 140rpx; margin: 24rpx 0; font-size: 30rpx; }.text-action { padding: 20rpx 0; font-size: 25rpx; text-decoration: underline; }.piece-preview image { width: 100%; height: 430rpx; }.piece-words { display: block; font-size: 38rpx; line-height: 1.5; overflow-wrap: anywhere; }
.collage { position: relative; width: 100%; height: 680rpx; margin: 36rpx 0; background: #3C473D; }.collage-slot { position: absolute; box-sizing: border-box; padding: 6rpx; background: #242522; }.collage-slot image { width: 100%; height: 100%; pointer-events: none; }.slot-label { position: absolute; top: 8rpx; left: 8rpx; padding: 5rpx; font-size: 15rpx; font-weight: 900; background: #A8D900; pointer-events: none; }.collage-text { height: 100%; box-sizing: border-box; background: #E9C52C; padding: 35rpx 12rpx 8rpx; overflow: hidden; display: flex; flex-direction: column; justify-content: center; }.collage-text text { font-size: 20rpx; line-height: 1.35; overflow-wrap: anywhere; }.collage-text text:first-child { font-size: 14rpx; margin-bottom: 9rpx; font-weight: 900; }.dragging { opacity: .65; }.drop-target { outline: 5rpx solid #A8D900; z-index: 5; }
.arrange-row { display: flex; align-items: center; gap: 18rpx; border-bottom: 1rpx solid; padding: 14rpx 0; font-size: 23rpx; }.arrange-row > text { flex: 1; }.arrange-row > view { padding: 15rpx 10rpx; text-decoration: underline; }
.poster-heading { display: block; font-size: 50rpx; font-weight: 900; line-height: 1; margin: 38rpx 0; }.trace-row { padding: 18rpx 0; border-top: 1rpx solid; }.trace-row text { display: block; font-size: 28rpx; line-height: 1.5; }.trace-row text:first-child { font-size: 20rpx; color: #465047; }.eyebrow { font-size: 19rpx; font-weight: 900; }.poster-actions text { display: block; font-size: 17rpx; margin-top: 8rpx; }.footer { margin: 40rpx 0; flex-wrap: wrap; font-size: 24rpx; }.footer view { padding: 18rpx 0; text-decoration: underline; }
.candidate-sheet { position: fixed; z-index: 30; top: 15%; bottom: 0; left: 0; right: 0; background: #ECEDE7; padding: 30rpx; border-top: 6rpx solid; }.sheet-head { font-size: 28rpx; font-weight: 800; padding-bottom: 24rpx; }.sheet-head view { padding: 14rpx; }.candidate-scroll { height: 85%; }.candidate { display: flex; align-items: center; gap: 24rpx; padding: 14rpx 0; border-top: 1rpx solid; }.candidate image { width: 170rpx; height: 130rpx; }.candidate text { flex: 1; font-size: 26rpx; }
.cut-poster-canvas { position: fixed; top: -2200px; left: -1200px; width: 360px; height: 640px; opacity: 0; pointer-events: none; }

/* Editorial selection and finished edition. */
.recommendations { display:flex; flex-direction:row; flex-wrap:wrap; justify-content:space-between; gap:0; }
.recommendation { position:relative; width:48%; height:370rpx; margin-bottom:16rpx; box-sizing:border-box; border:3rpx solid #242522; overflow:hidden; background:#242522; color:#ECEDE7; }
.recommendation image { display:block; width:100%; height:100%; }.recommendation-1 { margin-top:24rpx; }.recommendation-3 { margin-top:24rpx; }
.selection-number { position:absolute; top:10rpx; left:12rpx; font-size:54rpx; line-height:1; font-weight:900; background:#242522; padding:4rpx; }
.selection-caption { position:absolute; right:0; bottom:54rpx; left:0; padding:12rpx; background:#242522; }.selection-caption .photo-label { margin:0 0 5rpx; font-size:20rpx; }.selection-caption .photo-title { min-height:0; font-size:24rpx; line-height:1.4; }
.selection-actions { position:absolute; bottom:0; right:0; left:0; display:flex; justify-content:space-between; background:#242522; font-size:22rpx; }.selection-actions > view { padding:14rpx 12rpx; }.selection-actions .selection-kept { color:#242522; background:#A8D900; }.recommendation-kept { border-color:#A8D900; }
.piece-types > view { padding:20rpx 12rpx; min-width:0; }.piece-types text:first-child { font-size:60rpx; line-height:1; margin-bottom:28rpx; }.piece-types text:nth-child(2) { font-size:27rpx; line-height:1.5; }.piece-types text:last-child { font-size:17rpx; }.piece-types .piece-type-on { color:#A8D900; background:#242522; }
.slot-label { font-size:19rpx; }.arrange-row { font-size:24rpx; }.steps .step { box-sizing:border-box; font-size:22rpx; line-height:1.5; }.step-on { border-bottom:4rpx solid #242522; }
.cut-final .collage { margin-top:30rpx; }.cut-final .slot-label { display:none; }.cut-final .poster-heading { font-size:42rpx; line-height:1.4; margin:30rpx 0; }.final-trace { display:flex; flex-wrap:wrap; gap:16rpx; }.final-trace .trace-row { width:calc(50% - 8rpx); box-sizing:border-box; }.final-trace .trace-row text { font-size:25rpx; word-break:break-all; }.final-trace .trace-row text:first-child { font-size:20rpx; }.cut-final .final-save { background:#242522; color:#A8D900; text-align:center; padding:30rpx; }.final-edit-actions { display:flex; justify-content:space-between; margin-top:12rpx; font-size:24rpx; }.final-edit-actions > view { padding:20rpx 0; text-decoration:underline; }.cut-final .footer { border-top:1rpx solid #A7B59F; padding-top:12rpx; font-size:21rpx; color:#465047; }
@media (max-width:360px) { .piece-types { gap:8rpx; }.piece-types text:nth-child(2) { font-size:25rpx; }.selection-caption .photo-title { font-size:23rpx; } }

.exported-poster { display:block; width:100%; height:auto; border:2rpx solid #242522; box-sizing:border-box; }
