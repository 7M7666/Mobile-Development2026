page { height: 100vh; background: #ECEDE7; font-family: Arial, "Helvetica Neue", "PingFang SC", sans-serif; }.cut { height: 100vh; box-sizing: border-box; overflow: hidden; color: #242522; background: #ECEDE7; transition: background 180ms ease-out; }.cut.theme-quiet { background: #A7B59F; }.cut.theme-wild { background: #9891F5; }.cut.theme-warm { background: #FF5944; }.cut.theme-random { background: #E9C52C; }.cut-scroll { height: 100%; padding: 24rpx 40rpx 48rpx; box-sizing: border-box; }.cut-mark, .return-actions { display: flex; align-items: center; justify-content: space-between; }.cut-mark { font-size: 18rpx; font-weight: 900; letter-spacing: 1.5rpx; }.back { padding: 8rpx 10rpx; color: #ECEDE7; background: #242522; }.cut-title { margin-top: 50rpx; }.cut-title text, .result-copy text, .empty-state > text { display: block; font-size: 100rpx; font-weight: 900; line-height: .74; letter-spacing: -7rpx; }.cut-title text:last-child { width: fit-content; margin-top: 18rpx; padding: 12rpx 14rpx 17rpx; color: #ECEDE7; background: #242522; }.cut-step { display: flex; justify-content: space-between; margin-top: 66rpx; padding-bottom: 12rpx; border-bottom: 4rpx solid #242522; font-size: 19rpx; font-weight: 900; letter-spacing: 1.3rpx; }.cut-step text:last-child { color: #ECEDE7; }.place-picker { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 18rpx; }.place-tile { position: relative; height: 284rpx; overflow: hidden; border: 4rpx solid #242522; box-sizing: border-box; }.place-tile image { width: 100%; height: 100%; filter: grayscale(1); }.place-on { border-color: #ECEDE7; box-shadow: inset 0 0 0 5rpx #242522; }.place-on image { filter: none; }.place-tile-copy { position: absolute; right: 0; bottom: 0; left: 0; display: flex; flex-direction: column; padding: 13rpx; color: #ECEDE7; background: linear-gradient(transparent, #242522E8); }.place-tile-copy text:first-child { color: #A8D900; font-size: 17rpx; font-weight: 900; }.place-tile-copy text:nth-child(2) { margin-top: 3rpx; font-size: 31rpx; font-weight: 900; line-height: .85; letter-spacing: -2rpx; }.place-tile-copy text:last-child { margin-top: 7rpx; font-size: 15rpx; font-weight: 900; letter-spacing: 1rpx; }.feel-step { margin-top: 60rpx; }.vibe-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; margin-top: 18rpx; }.vibe-tile { display: flex; min-height: 188rpx; flex-direction: column; justify-content: space-between; padding: 16rpx; border: 4rpx solid #242522; box-sizing: border-box; font-weight: 900; }.vibe-tile text:first-child { font-size: 18rpx; letter-spacing: 1rpx; }.vibe-tile text:nth-child(2) { font-size: 36rpx; line-height: .86; letter-spacing: -2rpx; }.vibe-tile text:last-child { font-size: 16rpx; letter-spacing: .8rpx; }.vibe-quiet { background: #A7B59F; }.vibe-wild { background: #9891F5; }.vibe-warm { background: #FF5944; }.vibe-random { background: #A8D900; }.vibe-on { color: #ECEDE7; background: #242522; transform: translateY(-8rpx); }.make-cut { display: flex; align-items: center; justify-content: space-between; min-height: 92rpx; margin-top: 46rpx; padding: 0 20rpx; color: #ECEDE7; background: #242522; font-size: 25rpx; font-weight: 900; letter-spacing: 1rpx; }.make-cut text:last-child { color: #A8D900; font-size: 42rpx; }.result-title { margin-top: 58rpx; }.result-title text { display: block; font-weight: 900; }.result-title text:first-child { font-size: 104rpx; line-height: .74; letter-spacing: -8rpx; }.result-title text:nth-child(2) { margin-top: 28rpx; color: #FF5944; font-size: 74rpx; line-height: .76; letter-spacing: -5rpx; }.result-title text:last-child { margin-top: 12rpx; font-size: 30rpx; letter-spacing: -1rpx; }.cut-mosaic { position: relative; height: 780rpx; margin-top: 38rpx; background: #3C473D; }.cut-photo { position: absolute; overflow: hidden; border: 5rpx solid #242522; box-sizing: border-box; background: #9891F5; }.cut-photo image { width: 100%; height: 100%; }.cut-photo text { position: absolute; top: 10rpx; left: 10rpx; padding: 5rpx 7rpx; color: #242522; background: #A8D900; font-size: 18rpx; font-weight: 900; }.cut-photo-0 { top: 0; left: 0; width: 390rpx; height: 370rpx; }.cut-photo-1 { top: 42rpx; right: 0; width: 272rpx; height: 286rpx; transform: rotate(4deg); }.cut-photo-2 { right: 36rpx; bottom: 0; width: 366rpx; height: 384rpx; }.cut-photo-3 { bottom: 46rpx; left: 0; width: 226rpx; height: 260rpx; transform: rotate(-6deg); }.cut-photo-4 { top: 302rpx; left: 244rpx; width: 184rpx; height: 172rpx; transform: rotate(-3deg); }.result-copy { margin-top: 54rpx; }.result-copy text { font-size: 82rpx; }.result-copy text:last-child { width: fit-content; margin-top: 16rpx; padding: 8rpx 12rpx 14rpx; color: #ECEDE7; background: #242522; }.result-summary { display: block; margin-top: 28rpx; color: #3C473D; font-size: 22rpx; font-weight: 800; letter-spacing: .6rpx; }.make-another { margin-top: 52rpx; }.return-actions { gap: 12rpx; margin-top: 12rpx; }.return-actions view { flex: 1; padding: 19rpx 10rpx; color: #ECEDE7; background: #242522; font-size: 16rpx; font-weight: 900; letter-spacing: .7rpx; text-align: center; }.return-actions view:last-child { color: #242522; background: #A8D900; }.empty-state { display: flex; min-height: 72vh; flex-direction: column; justify-content: center; }.empty-state > text { font-size: 86rpx; }.empty-state .make-cut { margin-top: 58rpx; }
.why-cut { margin-top: 34rpx; border-top: 3rpx solid #242522; }.why-cut > view:first-child { display: flex; justify-content: space-between; padding: 16rpx 0; font-size: 18rpx; font-weight: 900; letter-spacing: 1rpx; }.why-list { border-top: 2rpx solid #242522; }.why-photo { display: flex; flex-direction: column; padding: 16rpx 0; border-bottom: 2rpx solid #242522; font-weight: 900; }.why-photo > text:first-child { font-size: 20rpx; }.why-photo > text:nth-child(2) { margin-top: 8rpx; color: #FF5944; font-size: 16rpx; letter-spacing: .8rpx; }.why-photo > view { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 10rpx; }.why-photo > view text { padding: 5rpx 7rpx; color: #ECEDE7; background: #242522; font-size: 14rpx; letter-spacing: .6rpx; }.return-actions { flex-wrap: wrap; }.return-actions view:last-child { flex-basis: 100%; color: #242522; background: #ECEDE7; }
.poster-cut-controls { margin-top: 18rpx; }.poster-cut-action { margin-top: 0; }.poster-ready-actions { margin-top: 0; }.poster-ready-actions view:last-child { flex-basis: auto; }.cut-poster-canvas { position: fixed; top: -2200px; left: -1200px; width: 360px; height: 640px; opacity: 0; pointer-events: none; }
.poster-cut-explainer { display: flex; flex-direction: column; gap: 7rpx; margin-bottom: 14rpx; padding: 14rpx 0; border-top: 3rpx solid #242522; border-bottom: 3rpx solid #242522; font-weight: 900; }.poster-cut-explainer text:first-child { font-size: 18rpx; letter-spacing: 1rpx; }.poster-cut-explainer text:not(:first-child) { font-size: 15rpx; letter-spacing: .6rpx; }
