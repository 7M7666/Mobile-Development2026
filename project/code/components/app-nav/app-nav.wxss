.app-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  min-height: 106rpx;
  padding: 12rpx 18rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #242522;
  border-top: 4rpx solid #A8D900;
}

.nav-item {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #B7BBB1;
}

.nav-mark {
  height: 28rpx;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 28rpx;
}

.nav-label {
  margin-top: 6rpx;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 1.5rpx;
}

.nav-active {
  color: #A8D900;
}
